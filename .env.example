# Copy only the variables you need into .env. Never commit real credentials.

# Same-day Lucknow delivery
# The feature remains enabled unless this is explicitly set to false.
SAME_DAY_DELIVERY_ENABLED=true

# Comma-separated pincode prefixes. `226` matches all six-digit 226xxx pincodes.
SAME_DAY_DELIVERY_PINCODE_PREFIXES=226

# Fallback display amount only. Shopify checkout charges the price configured on
# the hidden service product variant identified below.
SAME_DAY_DELIVERY_FEE_INR=30

# Create a hidden, published Shopify product such as "Same-day Lucknow delivery"
# and paste its Storefront variant GID here. Its Shopify price is the real charge.
SAME_DAY_DELIVERY_VARIANT_ID=gid://shopify/ProductVariant/REPLACE_ME

