# Copy only the variables you need into .env. Never commit real credentials.

# Same-day Lucknow delivery
# The feature remains enabled unless this is explicitly set to false.
SAME_DAY_DELIVERY_ENABLED=true

# Comma-separated pincode prefixes. `226` matches all six-digit 226xxx pincodes.
SAME_DAY_DELIVERY_PINCODE_PREFIXES=226

# Fallback display amount only. Shopify checkout charges the price configured on
# the hidden service product variant identified below.
SAME_DAY_DELIVERY_FEE_INR=30

# Create a hidden, published Shopify product such as "Same-day Lucknow delivery"
# and paste its Storefront variant GID here. Its Shopify price is the real charge.
SAME_DAY_DELIVERY_VARIANT_ID=gid://shopify/ProductVariant/REPLACE_ME

# Shopify Admin API
# Preferred: copy the Dev Dashboard app's Client ID and Secret. The server uses
# them to request a short-lived Admin token, caches it, and refreshes it
# automatically. Keep both values server-only in .env/Oxygen.
PRIVATE_SHOPIFY_ADMIN_CLIENT_ID=REPLACE_ME
PRIVATE_SHOPIFY_ADMIN_CLIENT_SECRET=REPLACE_ME

# Legacy fallback only. Client-credentials access tokens expire after 24 hours,
# so do not rely on this value when the Client ID and Secret are configured.
PRIVATE_SHOPIFY_ADMIN_API_TOKEN=

# Storefront discount ticket
# Put either the tag, code, or title of the active Shopify code discount that
# should be shown publicly on PDP/cart. The code itself is fetched from Shopify
# Admin. Tag is still preferred if you have multiple public code discounts. The
# app version must include read_discounts.
DISCOUNT_TICKET_TAG=storefront-ticket

# Order feedback persistence requires Admin API read_orders/write_orders access.
# Order-number tracking requires read_orders;
# orders older than Shopify's standard access window also require read_all_orders.
